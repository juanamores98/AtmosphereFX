<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net35</TargetFramework>
        <AssemblyName>AtmosphereFX</AssemblyName>
        <RootNamespace>AtmosphereFX</RootNamespace>
        <LangVersion>7.3</LangVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Product>AtmosphereFX</Product>
        <Version>1.0.0</Version>
        <ManagedDLLPath>$(MSBuildProgramFiles32)/Steam/steamapps/common/Cities_Skylines/Cities_Data/Managed</ManagedDLLPath>
        <FrameworkPathOverride>$(ManagedDLLPath)</FrameworkPathOverride>
        <AssemblySearchPaths>$(AssemblySearchPaths);$(ManagedDLLPath)</AssemblySearchPaths>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp" />
        <Reference Include="ColossalManaged" />
        <Reference Include="ICities" />
        <Reference Include="UnityEngine" />
    </ItemGroup>

    <Target Name="DeployToModDirectory" AfterTargets="Build">
        <PropertyGroup>
            <DeployDir>$(LOCALAPPDATA)/Colossal Order/Cities_Skylines/Addons/Mods/AtmosphereFX/</DeployDir>
        </PropertyGroup>
        <MakeDir Directories="$(DeployDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
        <Message Importance="high" Text="Deployed to $(DeployDir)" />
    </Target>

</Project>
